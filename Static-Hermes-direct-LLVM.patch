+void shllvm_args_reify(void *shr, void *frame, void *lazy, uint32_t strict);
+void shllvm_new_target(void *out, void *frame);
+void shllvm_throw(void *shr, void *value);
+void shllvm_throw_type_error(void *shr, void *message);
