+/* Direct LLVM emission runtime bridge. Built once, never generated per program. */
+#ifndef SH_LLVM_RUNTIME_H
+#define SH_LLVM_RUNTIME_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
